{
  "name": "starfield-outpost-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck:tests": "tsc -p tests/tsconfig.json --pretty false",
    "test:components": "vitest run",
    "reference:build": "node scripts/localization/validate-localized-name-provenance.mjs && node scripts/build-reference-data.mjs && node --experimental-strip-types scripts/generate-reference-manifest.mjs",
    "reference:test": "node --experimental-strip-types --test scripts/biome-aware-outposts.test.mjs scripts/biome-reference-data.test.mjs scripts/body-resource-availability.test.mjs scripts/inorganic-resource-data.test.mjs scripts/item-reference-data.test.mjs scripts/verify-reference-deployment.test.mjs scripts/localization/*.test.mjs",
    "localization:provenance:test": "node --test scripts/localization/*.test.mjs",
    "localization:provenance:build": "node scripts/localization/build-localized-name-provenance.mjs",
    "localization:provenance:verify": "node scripts/localization/validate-localized-name-provenance.mjs",
    "localization:provenance:proof": "node scripts/localization/verify-localized-proof-targets.mjs",
    "localization:terminology:verify": "node scripts/localization/verify-official-terminology.mjs",
    "localization:reference-names:build": "node scripts/localization/build-reference-name-overlay.mjs",
    "localization:reference-names:verify": "node scripts/localization/verify-reference-name-overlay.mjs",
    "localization:fauna-evidence:build": "node scripts/localization/build-fauna-evidence-support.mjs",
    "localization:verify": "node scripts/localization/verify-localization.mjs",
    "localization:inputs:inspect": "node scripts/localization/localization-inputs.mjs --inspect",
    "localization:inputs:extract": "node scripts/localization/localization-inputs.mjs",
    "localization:review": "node --experimental-strip-types scripts/generate-review-package.ts",
    "localization:review:adjudicate": "node --experimental-strip-types scripts/adjudicate-review-package.ts",
    "benchmark:history": "node --expose-gc --experimental-strip-types scripts/history-benchmark.ts",
    "benchmark:import-capacity": "node scripts/import-capacity-benchmark.mjs",
    "reference:verify": "node --experimental-strip-types scripts/verify-reference-deployment.mjs",
    "build": "node scripts/localization/validate-localized-name-provenance.mjs && node scripts/localization/verify-reference-name-overlay.mjs --locale ja-JP && node scripts/localization/verify-reference-name-overlay.mjs --locale fr-FR && node scripts/localization/verify-reference-name-overlay.mjs --locale de-DE && node scripts/localization/verify-reference-name-overlay.mjs --locale es-ES && node scripts/localization/verify-reference-name-overlay.mjs --locale it-IT && node scripts/localization/verify-reference-name-overlay.mjs --locale pt-BR && npm run reference:verify && tsc -b && vite build && node --experimental-strip-types scripts/verify-reference-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
