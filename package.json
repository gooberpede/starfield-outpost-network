{
  "name": "starfield-outpost-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "reference:build": "node scripts/localization/validate-localized-name-provenance.mjs && node scripts/build-reference-data.mjs",
    "reference:test": "node --test scripts/biome-aware-outposts.test.mjs scripts/biome-reference-data.test.mjs scripts/body-resource-availability.test.mjs scripts/inorganic-resource-data.test.mjs scripts/item-reference-data.test.mjs scripts/localization/*.test.mjs",
    "localization:provenance:test": "node --test scripts/localization/*.test.mjs",
    "localization:provenance:build": "node scripts/localization/build-localized-name-provenance.mjs",
    "localization:provenance:verify": "node scripts/localization/validate-localized-name-provenance.mjs",
    "localization:provenance:proof": "node scripts/localization/verify-localized-proof-targets.mjs",
    "localization:reference-names:build": "node scripts/localization/build-reference-name-overlay.mjs",
    "localization:reference-names:verify": "node scripts/localization/verify-reference-name-overlay.mjs",
    "localization:inputs:inspect": "node scripts/localization/localization-inputs.mjs --inspect",
    "localization:inputs:extract": "node scripts/localization/localization-inputs.mjs",
    "localization:review": "node --experimental-strip-types scripts/generate-japanese-review-package.ts",
    "benchmark:history": "node --expose-gc --experimental-strip-types scripts/history-benchmark.ts",
    "build": "node scripts/localization/validate-localized-name-provenance.mjs && node scripts/localization/verify-reference-name-overlay.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
